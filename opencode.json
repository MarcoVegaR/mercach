{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": ["php", "artisan", "boost:mcp"]
        },
        "postgresql": {
            "type": "local",
            "enabled": true,
            "command": [
                "bash",
                "-lc",
                "set -a; source .env; set +a; npx -y @modelcontextprotocol/server-postgres postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}"
            ]
        }
    }
}
