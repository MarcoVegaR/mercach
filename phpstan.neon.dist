includes:
    - vendor/larastan/larastan/extension.neon
    # Opcional: extensión de Carbon si la necesitas
    # - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app
        - database
        - routes
        - config
    level: 6
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # Reports: allow missing generic types / iterable value types in report query helpers
        -
            message: '#Method\s+App\\Services\\Reports\\DailyBankReconciliationQuery::.*does\s+not\s+specify\s+its\s+types:.*#'
            paths:
                - app/Services/Reports/DailyBankReconciliationQuery.php
        -
            message: '#Method\s+App\\Services\\Reports\\DailyBankReconciliationQuery::.*return\s+type\s+has\s+no\s+value\s+type\s+specified\s+in\s+iterable\s+type\s+array\.#'
            paths:
                - app/Services/Reports/DailyBankReconciliationQuery.php
        -
            message: '#Method\s+App\\Services\\Reports\\LocalsFinancialStatusQuery::.*does\s+not\s+specify\s+its\s+types:.*#'
            paths:
                - app/Services/Reports/LocalsFinancialStatusQuery.php
        -
            message: '#Method\s+App\\Services\\Reports\\LocalsFinancialStatusQuery::.*return\s+type\s+has\s+no\s+value\s+type\s+specified\s+in\s+iterable\s+type\s+array\.#'
            paths:
                - app/Services/Reports/LocalsFinancialStatusQuery.php
        -
            message: '#chargesOutstandingCurrencyMinorBatch\(\) has parameter \$charges with generic class Illuminate\\Support\\Collection but does not specify its types:.*#'
            paths:
                - app/Support/FxConversionHelper.php
        -
            message: '#chargesOutstandingCurrencyMinorBatch\(\) return type has no value type specified in iterable type array\.#'
            paths:
                - app/Support/FxConversionHelper.php
        # Trait analysed but not used (we keep it for future controllers)
        -
            message: '#Trait\s+App\\Http\\Controllers\\Concerns\\HandlesShow\s+is\s+used\s+zero\s+times#'
            paths:
                - app/Http/Controllers/Concerns/HandlesShow.php
        # Allow generic trait warning for Local HasFactory (docblock is present but tooling may still warn)
        -
            message: '#Class\s+App\\Models\\Local\s+uses\s+generic\s+trait\s+Illuminate\\Database\\Eloquent\\Factories\\HasFactory\s+but\s+does\s+not\s+specify\s+its\s+types#'
            paths:
                - app/Models/Local.php
        # Allow generic BelongsTo warnings for relationships where we avoid docblocks
        -
            message: '#Method\s+App\\Models\\Payment::(paymentType|payerDocumentType)\(\)\s+return\s+type\s+with\s+generic\s+class\s+Illuminate\\Database\\Eloquent\\Relations\\BelongsTo\s+does\s+not\s+specify\s+its\s+types:.*#'
            paths:
                - app/Models/Payment.php
        # Allow generic trait warning for models without custom factories
        -
            message: '#Class\s+App\\Models\\(BankTransaction|CompanyBankAccount|CreditApplication|CustomerCredit|FxRate|Payment|PaymentAllocation)\s+uses\s+generic\s+trait\s+Illuminate\\Database\\Eloquent\\Factories\\HasFactory\s+but\s+does\s+not\s+specify\s+its\s+types#'
            paths:
                - app/Models/BankTransaction.php
                - app/Models/CompanyBankAccount.php
                - app/Models/CreditApplication.php
                - app/Models/CustomerCredit.php
                - app/Models/FxRate.php
                - app/Models/Payment.php
                - app/Models/PaymentAllocation.php
        # Eloquent relation template variance warnings (TDeclaringModel not covariant in Larastan)
        -
            message: '#should return.*Relations.*(BelongsTo|HasMany).*but returns.*\$this#'
