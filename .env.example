# =============================================================================
# MERCACH - Environment Configuration
# =============================================================================
# Este archivo es un TEMPLATE. Copia a .env y configura según tu entorno.
#
# LOCAL:      Usa database para cache/queue, local para storage
# PRODUCCIÓN: Usa redis para cache/queue, s3 para storage
# =============================================================================

APP_NAME="Merca Chacao"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# =============================================================================
# LOGGING
# =============================================================================
# Local: stderr | Production: daily,slack
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_SLACK_WEBHOOK_URL=  # Solo producción

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mercach
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_TIMEZONE=America/Caracas

# =============================================================================
# CACHE, QUEUE & SESSION
# =============================================================================
# Local: database | Producción: redis
CACHE_STORE=database
CACHE_PREFIX=mercach_

QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Redis (solo si usas redis en cache/queue/session)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# FILESYSTEM
# =============================================================================
# Local: local | Producción: s3
FILESYSTEM_DISK=local

# AWS S3 (solo producción - Laravel Cloud provee estas credenciales)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# MAIL
# =============================================================================
# Local: log | Producción: smtp (resend, ses, etc.)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mercach.gob.ve"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# BANK GATEWAY (100% Banco - ValTrxIn)
# =============================================================================
# ⚠️ SECRETS: BANK_GATEWAY_KEY, BANK_GATEWAY_SECRET, MERCHANT_ID, TERMINAL_ID
#    Configurar en Laravel Cloud Secrets, NUNCA commitear valores reales
BANK_GATEWAY_SCHEME=https
BANK_GATEWAY_HOST=www8.100x100banco.com
# Certificación: /100p2pCert/... | Producción: /100p2p/...
BANK_GATEWAY_PATH=/100p2pCert/api/v1/ValTrxIn
BANK_GATEWAY_KEY=
BANK_GATEWAY_SECRET=
BANK_GATEWAY_MERCHANT_ID=
BANK_GATEWAY_TERMINAL_ID=
BANK_GATEWAY_TIMEOUT=30
BANK_GATEWAY_VERIFY_SSL=true

# =============================================================================
# SMS (Twilio - opcional)
# =============================================================================
TWILIO_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# =============================================================================
# FRONTEND
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
BROADCAST_CONNECTION=log
