# E2E Testing Environment Configuration
# This file is used by Playwright e2e tests in CI
# It ensures proper session persistence and cookie handling

APP_NAME="Merca Chacao"
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:mI96+cChBgArXD9TUKMTt87YyPh5fLmyBIXhhq8DC0g=
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=testing
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL for CI (same as production to avoid SQL compatibility issues)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mercach_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

# CRITICAL: Use file session driver for e2e tests
# 'array' driver does NOT persist between requests, breaking auth
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Disable secure cookies for local/CI testing (no HTTPS)
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
